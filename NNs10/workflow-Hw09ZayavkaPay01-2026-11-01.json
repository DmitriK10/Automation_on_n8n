      "id": "a0000000-0000-4000-8000-000000000003",
      "name": "3. Токен GigaChat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
