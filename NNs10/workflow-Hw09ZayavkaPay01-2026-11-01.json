      "id": "a0000000-0000-4000-8000-00000000000a",
      "name": "10. Проверка ссылки",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2128,
        304
      ],
      "notesInFlow": false,
      "onError": "continueRegularOutput",
      "notes": "GET без перехода по редиректу: 302 = форма оплаты жива. Ответ 302 приходит как ошибка — её разбирает следующая нода."
    },
    {
      "parameters": {
        "jsCode": "// Разбор ответа проверки ссылки.\n// ЮMoney на HEAD отвечает 302 — это норма, форма оплаты существует.\n// n8n показывает такой ответ как ошибку, поэтому трактуем явно.\n\nconst pay = $('9. Собрать ссылку QuickPay').item.json;\nconst res = $json;\n\nlet alive = false;\nlet reason = '';\n\nif (res.error) {\n  const msg = String(res.error.message || res.error);\n  // 302 в тексте ошибки = редирект на страницу оплаты, ссылка жива\n  if (msg.includes('302')) {\n    alive = true;\n    reason = 'HTTP 302 — форма оплаты отвечает редиректом';\n  } else {\n    reason = 'Ошибка запроса: ' + msg.slice(0, 120);\n  }\n} else if (res.statusCode === 200 || res.statusCode === 302) {\n  alive = true;\n  reason = 'HTTP ' + res.statusCode + ' — форма оплаты отвечает';\n} else {\n  reason = 'Неожиданный ответ: HTTP ' + (res.statusCode ?? 'нет');\n}\n\nreturn [{\n  json: {\n    payment_url: pay.payment_url,\n    recordId: pay.recordId,\n    sum: pay.sum,\n    targets: pay.targets,\n    label: pay.label,\n    link_ok: alive,\n    link_check: reason,\n  }\n}];"
      },
      "id": "a0000000-0000-4000-8000-000000000010",
      "name": "10a. Разбор проверки ссылки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        304
      ]
    },
    {
      "parameters": {
        "fromEmail": "ymd@yandex.ru",
        "toEmail": "={{ $('5. Парсинг и проверка JSON').item.json.data.email }}",
        "subject": "=Счёт на оплату: {{ $('5. Парсинг и проверка JSON').item.json.data.payment_description }}",
        "emailFormat": "text",
        "text": "={{ $('11. Письмо от ИИ').item.json.choices[0].message.content }}\n\nСсылка на оплату: {{ $('9. Собрать ссылку QuickPay').item.json.payment_url }}\n\nЕсли ссылка не открывается — ответьте на это письмо, пришлём новую.",
        "options": {}
      },
