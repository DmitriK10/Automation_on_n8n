    {
      "parameters": {
        "method": "POST",
        "url": "https://gigachat.devices.sberbank.ru/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"GigaChat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты помощник по обработке входящих заявок. Твоя задача — проанализировать заявку и вернуть структурированный результат строго в формате JSON, без markdown и без пояснений.\\n\\nВерни объект ровно с такими полями:\\n{\\n  \\\"client_name\\\": \\\"\\\",\\n  \\\"request_type\\\": \\\"\\\",\\n  \\\"request_summary\\\": \\\"\\\",\\n  \\\"payment_description\\\": \\\"\\\",\\n  \\\"amount\\\": \\\"\\\",\\n  \\\"priority\\\": \\\"\\\"\\n}\\n\\nПравила:\\n- client_name — имя клиента как в заявке, не переформатируй;\\n- request_type — одно из: Консультация, Услуга, Поддержка;\\n- request_summary — одно короткое предложение о том, что нужно клиенту, своими словами;\\n- payment_description — формулировка для назначения платежа, до 100 символов;\\n- amount — сумма ровно та, что пришла в заявке, числом без пробелов и знаков;\\n- priority — одно из: высокий, средний, низкий;\\n- НЕ выдумывай цены, скидки, сроки, гарантии и условия, которых нет в заявке.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Данные заявки:\\nИмя клиента: ' + $('1. Форма заявки').item.json.name + '\\nКонтакт: ' + $('1. Форма заявки').item.json.contact + '\\nЭлектронная почта: ' + $('1. Форма заявки').item.json.email + '\\nУслуга: ' + $('1. Форма заявки').item.json.service + '\\nСумма: ' + $('1. Форма заявки').item.json.amount + '\\nКомментарий: ' + $('1. Форма заявки').item.json.comment) }}\n    }\n  ],\n  \"temperature\": 0.1,\n  \"max_tokens\": 500,\n  \"stream\": false\n}",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 90000
        }
      },
      "id": "a0000000-0000-4000-8000-000000000004",
      "name": "4. GigaChat — разбор заявки",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Разбор ответа модели и три проверки из урока:\n// 1) JSON распарсился, 2) обязательные поля на месте,\n// 3) сумма и контакты не переформатированы моделью.\n// Плюс приоритет заявки.\n\nconst form = $('1. Форма заявки').item.json;\nconst raw = $json.choices[0].message.content;\n\n// модель иногда оборачивает JSON в ```json … ``` — снимаем обёртку\nlet text = String(raw).trim();\ntext = text.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n\nlet data;\ntry {\n  data = JSON.parse(text);\n} catch (e) {\n  throw new Error('Модель вернула не JSON: ' + text.slice(0, 200));\n}\n\nconst REQUIRED = ['client_name', 'request_type', 'request_summary',\n                  'payment_description', 'amount', 'priority'];\nconst missing = REQUIRED.filter(k => data[k] === undefined || data[k] === null || String(data[k]).trim() === '');\nif (missing.length) {\n  throw new Error('В ответе модели нет полей: ' + missing.join(', '));\n}\n\n// сверка суммы: модель не должна её менять\nconst amountForm = Number(String(form.amount).replace(/[^0-9.,]/g, '').replace(',', '.'));\nconst amountAi = Number(String(data.amount).replace(/[^0-9.,]/g, '').replace(',', '.'));\nif (!isFinite(amountAi) || amountAi !== amountForm) {\n  throw new Error('Сумма не совпала: в заявке ' + amountForm + ', в ответе модели ' + data.amount);\n}\n\n// сверка контактов: почта и телефон/ник должны остаться как в заявке\nif (String(data.client_name).trim() !== String(form.name).trim()) {\n  throw new Error('Имя изменено моделью: ' + data.client_name + ' вместо ' + form.name);\n}\n\n// приоритет: модель может вернуть свой, но значение должно быть из списка\nconst PRIORITIES = ['высокий', 'средний', 'низкий'];\nlet priority = String(data.priority).toLowerCase().trim();\nif (!PRIORITIES.includes(priority)) {\n  priority = 'средний';\n}\n\nreturn [{\n  json: {\n    data: {\n      client_name: String(form.name).trim(),\n      contact: String(form.contact).trim(),\n      email: String(form.email).trim(),\n      request_type: String(data.request_type).trim(),\n      request_summary: String(data.request_summary).trim(),\n      payment_description: String(data.payment_description).trim(),\n      amount: amountForm,\n      priority: priority,\n    },\n    // исходный ответ модели — для отчёта и отладки\n    model_raw: text,\n  }\n}];"
      },
      "id": "a0000000-0000-4000-8000-000000000005",
