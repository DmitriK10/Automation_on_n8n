[{"updatedAt":"2026-10-31T14:41:32.000Z","createdAt":"2026-10-31T11:15:33.369Z","id":"Hw08WebhookMail01","name":"Урок 8 — Вебхук → ИИ → письмо клиенту","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"content":"## ДЗ урока 8 — автоответ на заявку\n**Webhook → подготовка данных → GigaChat → письмо клиенту.**\n\n1. **Вебхук** — принимает POST на `/webhook/demo-zayavka`.\n2. **Подготовка данных** — из тела заявки берём только нужное: `ClientName`, `Email`, `RequestTopic`, `RequestText`, `Source`. В ИИ уходит структура, а не весь JSON.\n3. **access-токен** — обмен ключа Сбера на токен (живёт 30 минут).\n4. **Письмо от ИИ** — промпт лежит прямо в теле запроса, данные заявки подставляются переменными.\n5. **Отправка письма** — нода Send Email, SMTP.\n\n**Ignore SSL Issues** включён: у Сбера сертификат Минцифры.\n\nКлючи в сценарии не хранятся — только в Credentials.","height":420,"width":640,"color":5},"id":"e0000000-0000-4000-8000-000000000000","name":"Заметка — как устроен сценарий","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-120,-140]},{"parameters":{"httpMethod":"POST","path":"demo-zayavka","responseMode":"onReceived","options":{}},"id":"e1000000-0000-4000-8000-000000000001","name":"Webhook — приём заявки","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[600,280],"webhookId":"hw08-demo-zayavka"},{"parameters":{"assignments":{"assignments":[{"id":"e2000000-0000-4000-8000-00000000000a","name":"ClientName","value":"={{ $json.body.name }}","type":"string"},{"id":"e2000000-0000-4000-8000-00000000000b","name":"Email","value":"={{ $json.body.email }}","type":"string"},{"id":"e2000000-0000-4000-8000-00000000000c","name":"RequestTopic","value":"={{ $json.body.topic }}","type":"string"},{"id":"e2000000-0000-4000-8000-00000000000d","name":"RequestText","value":"={{ $json.body.message }}","type":"string"},{"id":"e2000000-0000-4000-8000-00000000000e","name":"Source","value":"={{ $json.body.source }}","type":"string"}]},"options":{}},"id":"e3000000-0000-4000-8000-000000000002","name":"1. Подготовка данных","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[900,280]},{"parameters":{"method":"POST","url":"https://ngw.devices.sberbank.ru:9443/api/v2/oauth","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Accept","value":"application/json"},{"name":"RqUID","value":"={{ Array.from({length:36}, (_, i) => [8,13,18,23].includes(i) ? '-' : (i === 14 ? '4' : (i === 19 ? '89ab'[Math.floor(Math.random() * 4)] : '0123456789abcdef'[Math.floor(Math.random() * 16)]))).join('') }}"}]},"sendBody":true,"contentType":"form-urlencoded","bodyParameters":{"parameters":[{"name":"scope","value":"GIGACHAT_API_PERS"}]},"options":{"allowUnauthorizedCerts":true,"timeout":60000}},"id":"e4000000-0000-4000-8000-000000000003","name":"2. access-токен","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1220,280],"credentials":{"httpHeaderAuth":{"id":"Hw07GigaChat0001","name":"GigaChat — ключ авторизации (Basic)"}}},{"parameters":{"method":"POST","url":"https://gigachat.devices.sberbank.ru/api/v1/chat/completions","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $json.access_token }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"GigaChat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты помощник менеджера по клиентским заявкам. Твоя задача — на основе данных заявки подготовить короткое деловое письмо клиенту. Требования: обратиться к клиенту по имени; кратко подтвердить, что запрос понят; назвать тему обращения так, как её указал клиент; предложить следующий шаг — менеджер свяжется и уточнит детали; закончить подписью «С уважением, команда проекта». СТРОГО ЗАПРЕЩЕНО выдумывать цены, скидки, сроки, гарантии и любые условия, которых нет в заявке. Не используй капс и множество восклицательных знаков. Структура письма: приветствие по имени → подтверждение запроса → следующий шаг → подпись. Верни только текст письма, без пояснений и без markdown.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Данные заявки:\\nИмя клиента: ' + $('1. Подготовка данных').item.json.ClientName + '\\nТема обращения: ' + $('1. Подготовка данных').item.json.RequestTopic + '\\nТекст обращения: ' + $('1. Подготовка данных').item.json.RequestText + '\\nИсточник заявки: ' + $('1. Подготовка данных').item.json.Source) }}\n    }\n  ],\n  \"temperature\": 0.4,\n  \"max_tokens\": 600\n}","options":{"allowUnauthorizedCerts":true,"timeout":90000}},"id":"e5000000-0000-4000-8000-000000000004","name":"3. Письмо от ИИ","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1540,280]},{"parameters":{"fromEmail":"ymd@yandex.ru","toEmail":"={{ $('1. Подготовка данных').item.json.Email }}","subject":"=Ваша заявка принята: {{ $('1. Подготовка данных').item.json.RequestTopic }}","emailFormat":"text","text":"={{ $json.choices[0].message.content }}","options":{}},"id":"e6000000-0000-4000-8000-000000000005","name":"4. Отправка письма","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1860,280],"credentials":{"smtp":{"id":"Hw08YandexSmtp01","name":"Яндекс.Почта — ymd@yandex.ru"}}}],"connections":{"Webhook — приём заявки":{"main":[[{"node":"1. Подготовка данных","type":"main","index":0}]]},"1. Подготовка данных":{"main":[[{"node":"2. access-токен","type":"main","index":0}]]},"2. access-токен":{"main":[[{"node":"3. Письмо от ИИ","type":"main","index":0}]]},"3. Письмо от ИИ":{"main":[[{"node":"4. Отправка письма","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"instanceId":"homework-lesson-8"},"nodeGroups":[],"pinData":{},"versionId":"c1370755-0352-4cb4-aafb-391d28dea57c","activeVersionId":"c1370755-0352-4cb4-aafb-391d28dea57c","versionCounter":3,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-10-31T11:15:33.384Z","createdAt":"2026-10-31T11:15:33.384Z","role":"workflow:owner","workflowId":"Hw08WebhookMail01","projectId":"bNi8QPMXiVYXjaBW","project":{"updatedAt":"2026-10-09T11:40:21.355Z","createdAt":"2026-10-08T19:56:04.982Z","id":"bNi8QPMXiVYXjaBW","name":"Дмитрий dmitrkomov@gmail.com <dmitrkomov@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"92796ee6-272d-437d-afe7-90291fb5003b"}}],"versionMetadata":{"name":null,"description":null}}]